# Local-development defaults. Replace the password before using any shared or
# deployed environment. Keep the real .env file out of Git.
POSTGRES_DB=smartcart
POSTGRES_USER=smartcart
POSTGRES_PASSWORD=smartcart_dev_password
POSTGRES_PORT=5432

# Optional demo compose override (the demo compose file defaults to 5434).
DEMO_POSTGRES_DB=smartcart_demo
DEMO_POSTGRES_USER=smartcart
DEMO_POSTGRES_PASSWORD=smartcart_dev_password
DEMO_POSTGRES_PORT=5434

DATABASE_URL=postgresql://smartcart:smartcart_dev_password@127.0.0.1:5432/smartcart
