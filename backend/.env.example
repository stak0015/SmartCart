DATABASE_URL=postgresql://smartcart:smartcart_dev_password@127.0.0.1:5432/smartcart
DATABASE_SSL=false

# Server-side keys. Never expose them through a NEXT_PUBLIC_* variable.
# Recommended: two restricted keys, one per API. The Routes key is optional:
# without it recommendations use the 25-nearest-premises fallback. If either
# key is left empty, the legacy GOOGLE_MAPS_API_KEY below is used for it.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_MAPS_REQUEST_TIMEOUT_SECONDS=10

# Legacy single-key fallback (Places API (New) + Routes API on one key).
GOOGLE_MAPS_API_KEY=

# Comma-separated browser origins permitted to call FastAPI.
CORS_ORIGINS=http://localhost:3000

# Cost and request controls. These are transparent planning assumptions.
ROUTE_MATRIX_CANDIDATE_LIMIT=25
PREMISE_LOCATION_MAX_AGE_DAYS=29
TRAVEL_COST_PUBLIC_TRANSPORT_BASE_PER_LEG_RM=1.00
TRAVEL_COST_PUBLIC_TRANSPORT_PER_KM_RM=0.08
TRAVEL_COST_MOTORCYCLE_PER_KM_RM=0.12
TRAVEL_COST_CAR_PER_KM_RM=0.45
