DATABASE_URL=postgresql://smartcart:smartcart_dev_password@127.0.0.1:5432/smartcart
DATABASE_SSL=false

# Server-side key. Never expose this through a NEXT_PUBLIC_* variable.
# Enable Places API (New) and Routes API, restrict the key, and set quotas.
GOOGLE_MAPS_API_KEY=

# Comma-separated browser origins permitted to call FastAPI.
CORS_ORIGINS=http://localhost:3000

# Cost and request controls. These are transparent planning assumptions.
ROUTE_MATRIX_CANDIDATE_LIMIT=25
PREMISE_LOCATION_MAX_AGE_DAYS=29
TRAVEL_COST_PUBLIC_TRANSPORT_BASE_PER_LEG_RM=1.00
TRAVEL_COST_PUBLIC_TRANSPORT_PER_KM_RM=0.08
TRAVEL_COST_MOTORCYCLE_PER_KM_RM=0.12
TRAVEL_COST_CAR_PER_KM_RM=0.45
