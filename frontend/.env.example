# Leave this unset when the Next.js app serves its own /api routes.
NEXT_PUBLIC_API_BASE_URL=

DATABASE_URL=postgresql://smartcart:smartcart_dev_password@127.0.0.1:5432/smartcart
DATABASE_SSL=false
DATABASE_POOL_SIZE=5

# Server-side key. Never rename this to NEXT_PUBLIC_* or expose it to the browser.
# Enable Places API (New) and Routes API, restrict the key to those APIs, and set quotas.
GOOGLE_MAPS_API_KEY=

# Cost and request controls. All travel costs are transparent planning assumptions.
ROUTE_MATRIX_CANDIDATE_LIMIT=25
PREMISE_LOCATION_MAX_AGE_DAYS=29
TRAVEL_COST_PUBLIC_TRANSPORT_BASE_PER_LEG_RM=1.00
TRAVEL_COST_PUBLIC_TRANSPORT_PER_KM_RM=0.08
TRAVEL_COST_MOTORCYCLE_PER_KM_RM=0.12
TRAVEL_COST_CAR_PER_KM_RM=0.45
